---
import Layout from '../layouts/Layout.astro';
import Team from '../components/Team.astro';
---

<Layout title="Team lineup | Koji">
  <meta slot="head" name="robots" content="noindex" />
  <main>
    <div class="content-width preview-nav">
      <a href="/#team">← Back to the Koji homepage</a>
    </div>
    <Team preview />
  </main>
</Layout>

<style>
  .preview-nav { padding-top: 38px; }
  .preview-nav a { color: var(--accent); font-weight: 700; text-underline-offset: 4px; }
</style>
