<div class="site-footer__horizon" data-footer-horizon aria-hidden="true">
  <div class="site-footer__stage">
    <span class="site-footer__kodo"><span class="site-footer__sprite"></span></span>
  </div>
</div>

<script>
  const horizon = document.querySelector<HTMLElement>('[data-footer-horizon]');
  const stage = horizon?.querySelector<HTMLElement>('.site-footer__stage');
  const kodo = stage?.querySelector<HTMLElement>('.site-footer__kodo');
  const sprite = kodo?.querySelector<HTMLElement>('.site-footer__sprite');

  if (horizon && stage && kodo && sprite) {
    // Left edges and heights of the walkable ridge in horizon.svg's 1440 × 252 viewBox.
    const steps = [
      [0, 170], [48, 180], [121, 172], [185, 161], [265, 168],
      [332, 182], [389, 196], [479, 189], [548, 197], [615, 205],
      [741, 197], [819, 182], [881, 166], [960, 155], [1023, 162],
      [1097, 174], [1171, 186], [1236, 177], [1304, 164]
    ];
    const motion = matchMedia('(prefers-reduced-motion: no-preference)');
    let visible = false;
    let animations: Animation[] = [];
    const poses = { idle: 0, crouch: 1, push: 2, float: 3, reach: 4, land: 5 };

    const updatePath = () => {
      animations.forEach((animation) => animation.cancel());
      animations = [];
      kodo.classList.toggle('is-hopping', motion.matches);
      if (!motion.matches) return;

      const scale = stage.getBoundingClientRect().width / 1440;
      const overshoot = kodo.offsetWidth / 2 + 6;
      // The scene is centered and clipped, so the visible first and last steps vary by screen.
      const left = (stage.offsetWidth - horizon.clientWidth) / 2 - overshoot;
      const right = left + horizon.clientWidth + 2 * overshoot;
      const heightAt = (x: number) => {
        const step = steps.findLast(([edge]) => edge * scale <= x);
        return (step?.[1] ?? steps[0][1]) * scale;
      };
      const landings = steps
        .map(([edge, height], i) => ({
          x: (edge + (steps[i + 1]?.[0] ?? 1440)) / 2 * scale,
          y: height * scale
        }))
        .filter(({ x }) => x > left + 12 && x < right - 12)
        .reverse();
      const route = [{ x: right, y: heightAt(right) }, ...landings, { x: left, y: heightAt(left) }];
      const frames: { time: number; transform: string }[] = [];
      const spriteFrames: { time: number; pose: number }[] = [{ time: 0, pose: poses.idle }];
      const addFrame = (time: number, x: number, y: number) => {
        frames.push({
          time,
          transform: `translate3d(${x}px, ${y}px, 0) translate(-50%, -92.857%)`
        });
      };

      let time = 0;
      addFrame(time, route[0].x, route[0].y);
      route.slice(1).forEach((to, index) => {
        const from = route[index];
        const distance = from.x - to.x;
        const duration = Math.max(860, Math.min(1250, 760 + distance * 5));
        const lift = Math.max(14, Math.min(38, distance * .42, Math.min(from.y, to.y) - kodo.offsetHeight + 8));
        const takeoff = time + 140;
        const landing = takeoff + duration;
        spriteFrames.push(
          { time: time + 20, pose: poses.crouch },
          { time: takeoff, pose: poses.push },
          { time: takeoff + duration * .23, pose: poses.float },
          { time: takeoff + duration * .72, pose: poses.reach },
          { time: landing, pose: poses.land },
          { time: landing + 120, pose: poses.idle }
        );
        addFrame(takeoff, from.x, from.y);
        for (let sample = 1; sample <= 12; sample++) {
          const progress = sample / 12;
          const glide = progress * progress * (3 - 2 * progress);
          const x = from.x - distance * glide;
          // The flatter crown gives the balloons time to carry Kodo before he descends.
          const y = from.y + (to.y - from.y) * glide - lift * Math.pow(Math.sin(Math.PI * progress), .85);
          addFrame(takeoff + duration * progress, x, y);
        }
        time = landing + 240;
      });

      time += 300;
      addFrame(time, route[route.length - 1].x, route[route.length - 1].y);
      spriteFrames.push({ time, pose: poses.idle });
      const timing = { duration: time, iterations: Infinity };
      animations = [
        kodo.animate(frames.map(({ time: at, transform }) => ({ transform, offset: at / time })), timing),
        sprite.animate(spriteFrames.map(({ time: at, pose }) => ({
          backgroundPosition: `${pose * 20}% 0%`,
          easing: 'steps(1, end)',
          offset: at / time
        })), timing)
      ];
      if (!visible) animations.forEach((animation) => animation.pause());
    };

    new ResizeObserver(updatePath).observe(horizon);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      animations.forEach((animation) => visible ? animation.play() : animation.pause());
    }).observe(horizon);
    motion.addEventListener('change', updatePath);
  }
</script>
