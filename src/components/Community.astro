---
const avatars = [2, 5, 9, 12, 16, 21, 27, 36, 7, 14, 23, 32, 3, 11, 17, 25, 31, 40];
---
<section class="section content-width community" id="community" aria-labelledby="community-title" data-orbit>
  <div class="orbit">
    <div class="orbit__ring" aria-hidden="true">
      {avatars.map((id, slot) => {
        const angle = slot / avatars.length * 2 * Math.PI;
        return (
          <span class="orbit__avatar" style={`--x: ${50 + 50 * Math.sin(angle)}%; --y: ${50 - 50 * Math.cos(angle)}%`}>
            <img src={`/assets/pfps/${id}.webp`} width="56" height="56" alt="" loading="lazy" decoding="async" />
          </span>
        );
      })}
    </div>
    <div class="community__copy">
      <h2 id="community-title">Built with our community.</h2>
      <p>Share what you’re playing, give feedback, and follow Koji’s development.</p>
      <a class="text-link" href="https://dsc.gg/brocolabs">Join the Discord <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <button class="orbit__toggle" type="button" hidden>Pause motion</button>
</section>
