---
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

const dir = join(process.cwd(), 'public/assets/pfps');
const files = readdirSync(dir)
  .filter((name) => name.endsWith('.webp'))
  .sort((a, b) => parseInt(a, 10) - parseInt(b, 10));

const outerCount = Math.min(files.length, Math.ceil(files.length / 2) + 2);

const ring = (names, offset) =>
  names.map((name, index) => ({
    src: `/assets/pfps/${name}`,
    angle: Math.round((360 / names.length) * index + offset)
  }));

const outer = ring(files.slice(0, outerCount), 0);
const inner = ring(files.slice(outerCount), 180 / Math.max(1, files.length - outerCount));
---

<section class="screen panel-screen" id="community" aria-label="Community">
  <div class="community">
    <div class="orbit">
      <div class="orbit__ring orbit__ring--outer">
        {
          outer.map((pfp) => (
            <span class="orbit__slot" style={`--a: ${pfp.angle}deg`}>
              <img class="orbit__pfp" src={pfp.src} alt="" loading="lazy" decoding="async" />
            </span>
          ))
        }
      </div>
      <div class="orbit__ring orbit__ring--inner">
        {
          inner.map((pfp) => (
            <span class="orbit__slot" style={`--a: ${pfp.angle}deg`}>
              <img class="orbit__pfp" src={pfp.src} alt="" loading="lazy" decoding="async" />
            </span>
          ))
        }
      </div>
      <div class="orbit__core">
        <h2 class="orbit__title">Built with our community</h2>
        <p class="orbit__sub">Feedback is essential to Koji's progress.</p>
      </div>
    </div>
  </div>
</section>
