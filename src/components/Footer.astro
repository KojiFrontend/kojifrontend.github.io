---
import FooterHorizon from './FooterHorizon.astro';
---
<footer class="site-footer">
  <div class="content-width">
    <div class="site-footer__top">
      <section class="get-koji" id="get-koji" aria-labelledby="access-title">
        <h2 id="access-title">Get Koji</h2>
        <p>Find release updates and help getting started on Discord.</p>
        <div class="get-koji__actions">
          <a class="button footer-discord" href="https://dsc.gg/brocolabs">
            <img src="/assets/icons/tabs/discord.webp" width="22" height="22" alt="" loading="lazy" />
            Open Discord <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
      <div class="site-footer__directories">
        <nav class="site-footer__nav" aria-labelledby="footer-explore">
          <h3 id="footer-explore">Explore</h3>
          <a href="#bento">Features</a>
          <a href="#themes">Themes</a>
          <a href="#community">Community</a>
        </nav>
        <div class="site-footer__nav">
          <h3>Support</h3>
          <a href="https://ko-fi.com/brocolabs">Ko-fi <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <a class="site-footer__brand" href="#home" aria-label="Koji for Android, home">
        <img src="/assets/brand/koji-mark.png" width="26" height="26" alt="" loading="lazy" />
        <span>Koji for Android</span>
      </a>
      <a href="#home">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
  <FooterHorizon />
</footer>
