---
const items = [
  { name: 'Jump back in', image: 'jumpback-1x2', width: 480 },
  { name: 'Box', image: 'box', width: 240 },
  { name: 'Kodo', image: 'kodo', width: 240 },
  { name: 'Favorites', image: 'mm', width: 240 },
  { name: 'Folders', image: 'folder', width: 240 },
  { name: 'New games', image: 'gift', width: 240 },
  { name: 'Random pick', image: 'random', width: 240 },
  { name: 'Playtime', image: 'stat', width: 240 },
  { name: 'Cloud saves', image: 'cloud', width: 240 }
];
---
<section class="scroller" aria-label="Koji widgets" data-scroller>
  <div class="scroller__backdrop" aria-hidden="true"></div>
  <div class="scroller__viewport" role="region" aria-label="Browse widgets" tabindex="0">
    <div class="scroller__track">
      {[false, true].map((duplicate) => (
        <ul class:list={['scroller__group', duplicate && 'scroller__group--duplicate']} role="list" aria-hidden={duplicate ? 'true' : undefined}>
          {items.map(({ name, image, width }) => (
            <li class="scroller__item">
              <img src={`/assets/icons/scroller/${image}.webp`} width={width} height="240" alt={duplicate ? '' : name} loading="lazy" decoding="async" />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<script>
  const strip = document.querySelector('[data-scroller]');
  const viewport = strip?.querySelector('.scroller__viewport');
  const track = viewport?.querySelector('.scroller__track');

  if (strip && viewport && track && 'IntersectionObserver' in window) {
    let frame = 0;
    let currentSpeed = 1;

    const getAnimation = () => track.getAnimations()[0];

    function easeSpeed(target: number, duration: number) {
      cancelAnimationFrame(frame);

      const animation = getAnimation();
      if (!animation) return;

      const start = performance.now();
      const initialSpeed = currentSpeed;

      const update = (now: number) => {
        const progress = Math.min(1, (now - start) / duration);

        // Smooth cubic easing
        const eased = target === 0
          ? 1 - Math.pow(1 - progress, 3)
          : progress * progress * (3 - 2 * progress);

        currentSpeed = initialSpeed + (target - initialSpeed) * eased;

        // Directly control animation speed
        animation.playbackRate = currentSpeed;

        if (progress < 1) {
          frame = requestAnimationFrame(update);
        } else {
          currentSpeed = target;
          animation.playbackRate = target;
        }
      };

      frame = requestAnimationFrame(update);
    }

    if (typeof track.getAnimations === 'function') {
      strip.classList.add('has-hover-easing');

      viewport.addEventListener('pointerenter', () => {
        easeSpeed(0, 700);
      });

      viewport.addEventListener('pointerleave', () => {
        easeSpeed(1, 500);
      });

      viewport.addEventListener('blur', () => {
        easeSpeed(viewport.matches(':hover') ? 0 : 1, 500);
      });
    }

    new IntersectionObserver(([entry]) => {
      strip.classList.toggle('is-visible', entry.isIntersecting);

      if (!entry.isIntersecting) {
        cancelAnimationFrame(frame);
      } else if (strip.classList.contains('has-hover-easing')) {
        easeSpeed(viewport.matches(':hover') ? 0 : 1, 500);
      }
    }).observe(strip);
  }
</script>