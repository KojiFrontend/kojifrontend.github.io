---
import BentoCard from './BentoCard.astro';

const cards = [
  {
    title: 'KoShop',
    text: 'Discover themes, games, and more in Koji’s built-in shop.',
    icon: '/assets/icons/bento/shop.webp',
    shot: '/assets/shots/shop.webp',
    tint: '240 96 48'
  },
  {
    title: 'Leaflet',
    text: 'A PictoChat-inspired social space built on Pocketpass.',
    icon: '/assets/icons/bento/social.webp',
    shot: '/assets/shots/leaflet.webp',
    tint: '72 200 72'
  },
  {
    title: 'Discord',
    text: 'Show what you’re playing or browsing with Discord Rich Presence.',
    icon: '/assets/icons/tabs/discord.webp',
    shot: '/assets/shots/discord.webp',
    tint: '88 101 242'
  },
  {
    title: 'Media',
    text: 'Revisit your favorite moments from your handheld.',
    icon: '/assets/icons/bento/media.webp',
    shot: '/assets/shots/media.webp',
    tint: '240 96 96'
  },
  {
    title: 'The Little Things',
    text: 'Folders, favorites, playtime, and a random game picker all fit into the same home menu. Don’t like the defaults? Koji has settings for just about everything.',
    icon: '/assets/icons/bento/logohlyph.webp',
    wide: true,
    tint: '144 120 240'
  }
];
---
<section class="section content-width" id="bento" aria-labelledby="features-title">
  <div class="feature-grid">
    <div class="feature-intro">
      <h2 id="features-title">A reimagining of the 3DS, as if it were made today.</h2>
    </div>
    {cards.map((card) => <BentoCard {...card} />)}
  </div>
</section>
