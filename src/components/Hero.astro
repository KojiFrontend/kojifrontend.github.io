<section class="hero" id="home" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true"></div>
  <div class="hero__inner">
    <h1 id="hero-title">
      The handheld frontend<br />made for <span class="sr-only">you</span><span class="hero__you" aria-hidden="true"><span class="hero__reel"><span>you</span><span>you</span><span>you</span><span>you</span></span></span>
    </h1>
    <figure class="console-preview" data-console>
      <div class="console-preview__halo" aria-hidden="true"></div>
      <img
        class="console-preview__image console-preview__image--thor"
        src="/assets/home/thor-640.webp"
        srcset="/assets/home/thor-640.webp 640w, /assets/home/thor-1080.webp 1080w"
        sizes="(max-width: 512px) calc((100vw - 32px) * .48), (max-width: 680px) 230px, 317px"
        width="1080"
        height="1239"
        alt="Thor clamshell handheld running Koji across both screens"
      />
      <img
        class="console-preview__image console-preview__image--odin"
        src="/assets/home/odin-880.webp"
        srcset="/assets/home/odin-880.webp 880w, /assets/home/odin-1560.webp 1560w"
        sizes="(max-width: 512px) calc((100vw - 32px) * .7), (max-width: 680px) 336px, 462px"
        width="1560"
        height="643"
        alt="Odin handheld showing the Koji game library"
        fetchpriority="high"
      />
      <picture class="hero__mascot">
        <source media="(prefers-reduced-motion: reduce)" srcset="/assets/home/kodo-still.webp" />
        <img src="/assets/home/kodo.webp" width="108" height="144" alt="Kodo, Koji’s balloon-riding mascot" />
      </picture>
    </figure>
    <div class="hero__copy">
      <p class="hero__description">Meet Koji, a game launcher for Android handhelds inspired by the 3DS home menu.</p>
      <div class="hero__actions">
        <a class="button button--raised" href="https://ko-fi.com/brocolabs">
          Early access on Ko-fi
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M15.586 7H10c-.639-.042-1.142-.603-.966-1.259c.122-.453.515-.711.966-.741h8c.198.013.325.033.5.134c.322.186.476.506.5.866v8c-.03.451-.288.844-.741.966c-.656.176-1.217-.327-1.259-.966V8.414l-9.95 9.95c-.41.359-1.01.404-1.414 0c-.405-.404-.359-1.005 0-1.414Z" /></svg>
        </a>
        <a class="hero__secondary" href="#bento">
          Explore features
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 17.242V4c.036-.543.428-1 1-1s.964.457 1 1v13.243l3.95-3.95c.481-.423 1.233-.381 1.573.207c.235.407.139.867-.159 1.207l-5.657 5.657c-.271.238-.606.355-.966.259c-.194-.053-.299-.128-.448-.259l-5.657-5.657c-.298-.34-.394-.8-.159-1.207c.34-.588 1.092-.63 1.573-.207Z" /></svg>
        </a>
      </div>
    </div>
  </div>
  <svg class="hero__wave" viewBox="0 0 1440 72" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 22C250 2 450 10 720 36S1170 58 1440 18V72H0Z" />
  </svg>
</section>

<script>
  const preview = document.querySelector<HTMLElement>('[data-console]');
  const hero = preview?.closest('.hero');
  const interactive = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  if (hero instanceof HTMLElement && preview) {
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        hero.classList.toggle('is-visible', entry.isIntersecting);
      }).observe(hero);
    }
    hero.addEventListener('pointermove', (event) => {
      if (!interactive.matches || event.pointerType === 'touch') return;
      const bounds = hero.getBoundingClientRect();
      const x = 2 * (event.clientX - bounds.left) / bounds.width - 1;
      const y = 2 * (event.clientY - bounds.top) / bounds.height - 1;
      preview.style.setProperty('--console-x', x.toFixed(3));
      preview.style.setProperty('--console-y', y.toFixed(3));
    });
    const reset = () => {
      preview.style.removeProperty('--console-x');
      preview.style.removeProperty('--console-y');
    };
    hero.addEventListener('pointerleave', reset);
    interactive.addEventListener('change', reset);
  }
</script>
