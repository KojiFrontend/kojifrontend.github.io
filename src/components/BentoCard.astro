---
const { title, text, icon, shot = null, shotSize = null, tint, ink, inkSoft, wide = false } = Astro.props;

const shotAttrs = shot
  ? { role: 'button', tabindex: '0', 'aria-haspopup': 'dialog', 'data-shot': shot, 'data-shot-size': shotSize }
  : {};
---
<article
  class:list={['card', shot && 'card--shot', wide && 'card--wide']}
  {...shotAttrs}
  style={`--tint: ${tint}; --ink: ${ink}; --ink-soft: ${inkSoft}`}
>
  <div class="card__head">
    <h2 class="card__title">{title}</h2>
    <img class="card__icon" src={icon} alt="" loading="lazy" decoding="async" />
  </div>
  <p class="card__text">{text}</p>
</article>
