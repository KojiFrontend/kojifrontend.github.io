---
const { title, text, icon, shot, tint, wide = false } = Astro.props;
---
<article class:list={['feature-card', wide && 'feature-card--wide']} style={`--tint: ${tint}`}>
  <div class="tile-heading">
    <h3>{title}</h3>
    <img src={icon} width="42" height="42" alt="" loading="lazy" decoding="async" />
  </div>
  <p>{text}</p>
  {shot && <a class="feature-card__preview text-link" href={shot} data-preview={title}>View screenshot <span aria-hidden="true">↗</span><span class="sr-only"> of {title}</span></a>}
</article>
